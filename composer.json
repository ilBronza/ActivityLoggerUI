{
    "name": "ilbronza/activityloggerui",
    "description": "Read-only model activity history UI with CRUD extra-field support.",
    "license": "MIT",
    "authors": [
        {
            "name": "Davide Bronzini",
            "email": "davide@sistema.srl",
            "homepage": "https://sistema.srl"
        }
    ],
    "homepage": "https://github.com/ilbronza/activityloggerui",
    "keywords": [
        "Laravel",
        "ActivityLoggerUI"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": ">=11.0",
        "illuminate/routing": ">=11.0",
        "illuminate/validation": ">=11.0",
        "illuminate/view": ">=11.0",
        "spatie/laravel-activitylog": ">=4.0"
    },
    "autoload": {
        "psr-4": {
            "IlBronza\\ActivityLoggerUI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IlBronza\\ActivityLoggerUI\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IlBronza\\ActivityLoggerUI\\ActivityLoggerUIServiceProvider"
            ],
            "aliases": {
                "ActivityLoggerUI": "IlBronza\\ActivityLoggerUI\\Facades\\ActivityLoggerUI"
            }
        }
    },
    "require-dev": {
        "orchestra/testbench": ">=9.0",
        "phpunit/phpunit": ">=11.0"
    },
    "suggest": {
        "ilbronza/crud": "Enables automatic discovery of CRUD ExtraField casts."
    },
    "scripts": {
        "test": "phpunit"
    }
}
